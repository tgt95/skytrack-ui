    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "node scripts/lint-ui-practices.mjs && node scripts/sync-sheet-specs.mjs",
    "sync:sheet": "node scripts/sync-sheet-specs.mjs",
    "test": "vitest run",
    "preview": "vite preview",
    "generate:exports": "node scripts/generate-exports.mjs",
    "build:lib": "node scripts/build-lib.mjs",
    "verify:lib": "node scripts/verify-lib.mjs",
    "pack:local": "mkdir -p ./dist-lib-tarball && npm run build:lib && npm pack --pack-destination ./dist-lib-tarball",
    "test:consumer": "node scripts/test-consumer.mjs",
    "prepack": "node scripts/guard-publish.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:site": "node scripts/build-site.mjs",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "sync:guide": "node scripts/sync-to-design-guide.mjs",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}' 'scripts/**/*.{mjs,ts}' 'vite*.ts' 'vitest.config.ts' package.json 'tsconfig*.json' README.md",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}' 'scripts/**/*.{mjs,ts}' 'vite*.ts' 'vitest.config.ts' package.json 'tsconfig*.json' README.md"
